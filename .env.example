# Dirty Truth & Dare — environment variables
#
# HOW TO USE ON VERCEL:
#   Dashboard: Project → Settings → Environment Variables → add each NAME.
#   CLI:       vercel env add LLM_URL production   (paste the value when asked)
#   Local pull for `vercel dev`:  vercel env pull .env.local
#
# On the origin box these live in the gitignored secrets.env instead — the app
# reads real environment variables first, then secrets.env.

# --- Cassia AI engine (LLM) — REQUIRED for generated challenges + chat -------
# OpenAI-compatible chat-completions endpoint.
LLM_URL=https://your-llm-endpoint.example/v1/chat/completions
LLM_KEY=change-me
LLM_MODEL=/tmp/models/qwen38-27b-q8kp.gguf

# --- Kokoro TTS — voice mode -------------------------------------------------
# Must be reachable FROM wherever the server code runs:
#   origin box : keep the loopback default below
#   Vercel     : point at a PUBLIC tunnel of port 8880
#                (see README "Voice on Vercel" / dirtytruth-tts-tunnel.service)
TTS_URL=http://127.0.0.1:8880/v1/audio/speech

# --- Room store location -----------------------------------------------------
# Origin box: leave unset (defaults to ./rooms.db next to rooms.py).
# Vercel/serverless: /tmp is ephemeral PER LAMBDA INSTANCE. Rooms work within
# one instance; two phones may hit different instances and miss each other.
# Run rooms on the origin box for guaranteed two-device play (README caveat).
DIRTYTRUTH_DB=/tmp/dirtytruth_rooms.db

# --- Per-IP rate limits (requests/minute, 0 disables) ------------------------
DT_RL_GENERATE=12
DT_RL_CHAT=20
DT_RL_TTS=20
DT_RL_ROOM_CREATE=10
DT_RL_ROOM_JOIN=30
DT_RL_ROOM_ACTION=240
DT_RL_ROOM_PREFS=60

# --- Optional TTS default voice ---------------------------------------------
TTS_VOICE=af_heart
